#:import dp kivy.metrics.dp
#:import MAX_NOTE_LENGTH models.mood.MAX_NOTE_LENGTH

<MDScreen>:
    size_hint: 1, 1

<MoodCircle>:
    size_hint: None, None
    size: dp(68), dp(68)
    on_release: app.select_mood(root.score)
    canvas.before:
        Color:
            rgba: root.circle_color
        Ellipse:
            pos: self.pos
            size: self.size
    canvas.after:
        Color:
            rgba: app.theme_cls.primaryColor if root.selected else (0, 0, 0, 0)
        Line:
            width: dp(3)
            ellipse: (self.x - dp(4), self.y - dp(4), self.width + dp(8), self.height + dp(8))
    MDLabel:
        theme_font_name: 'Custom'
        text: root.emoji
        font_name: 'Emoji'
        theme_text_color: 'Custom'
        text_color: 0, 0, 0, 1
        halign: 'center'
        valign: 'center'
        font_size: '28sp'

<MoodEntryItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(72)
    spacing: dp(14)
    padding: dp(16), dp(10)
    radius: [dp(16)]
    theme_bg_color: 'Custom'
    md_bg_color: app.theme_cls.surfaceContainerColor
    on_release: app.open_entry(root.entry_key)
    MDLabel:
        theme_font_name: 'Custom'
        text: root.emoji
        font_name: 'Emoji'
        theme_text_color: 'Custom'
        text_color: app.theme_cls.onSurfaceColor
        halign: 'center'
        valign: 'center'
        font_size: '26sp'
        size_hint_x: None
        width: dp(44)
    MDBoxLayout:
        orientation: 'vertical'
        size_hint_y: 1
        spacing: dp(2)
        MDLabel:
            text: root.entry_date
            font_style: 'Label'
            role: 'large'
            adaptive_height: True
            theme_text_color: 'Custom'
            text_color: app.theme_cls.onSurfaceColor
            bold: True
        MDLabel:
            text: root.note if root.note else app.strings['no_note']
            font_style: 'Body'
            role: 'small'
            adaptive_height: True
            theme_text_color: 'Custom'
            text_color: app.theme_cls.onSurfaceVariantColor

<NavigationItem>:
    MDNavigationItemIcon:
        icon: root.icon_name
    MDNavigationItemLabel:
        id: item_label
        text: app.strings.get(root.text_key, '')

MDBoxLayout:
    orientation: 'vertical'
    md_bg_color: app.theme_cls.backgroundColor

    MDScreenManager:
        id: screen_manager

        MDScreen:
            name: 'today'

            MDBoxLayout:
                orientation: 'vertical'
                padding: dp(20)
                spacing: dp(14)
                md_bg_color: app.theme_cls.surfaceContainerLowColor

                MDLabel:
                    text: app.strings['today']
                    font_style: 'Title'
                    role: 'large'
                    adaptive_height: True
                    theme_text_color: 'Custom'
                    text_color: app.theme_cls.primaryColor
                    bold: True

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(3)
                    radius: [dp(2)]
                    md_bg_color: app.theme_cls.primaryColor

                MDLabel:
                    id: today_date
                    font_style: 'Body'
                    role: 'large'
                    adaptive_height: True
                    theme_text_color: 'Custom'
                    text_color: app.theme_cls.onSurfaceVariantColor

                MDLabel:
                    text: app.strings['select_mood']
                    font_style: 'Label'
                    role: 'large'
                    adaptive_height: True

                MDCard:
                    style: 'outlined'
                    radius: [dp(24)]
                    padding: dp(16), dp(12)
                    size_hint_y: None
                    height: dp(100)
                    theme_bg_color: 'Custom'
                    md_bg_color: app.theme_cls.surfaceContainerColor

                    MDBoxLayout:
                        id: mood_circles
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(12)
                        pos_hint: {'center_x': 0.5}

                MDLabel:
                    id: selected_mood_label
                    font_style: 'Label'
                    role: 'large'
                    adaptive_height: True
                    halign: 'center'

                MDTextField:
                    id: note_field
                    mode: 'outlined'
                    radius: dp(16)
                    size_hint_y: None
                    height: dp(96)
                    multiline: True

                    MDTextFieldHintText:
                        text: app.strings['note_hint']
                    MDTextFieldMaxLengthText:
                        max_text_length: MAX_NOTE_LENGTH

                MDButton:
                    style: 'filled'
                    radius: dp(16)
                    pos_hint: {'center_x': 0.5}
                    on_release: app.save_note()

                    MDButtonText:
                        text: app.strings['save_note']

                MDButton:
                    style: 'text'
                    radius: dp(16)
                    pos_hint: {'center_x': 0.5}
                    on_release: app.reset_to_today()

                    MDButtonText:
                        text: app.strings['back_to_today']

        MDScreen:
            name: 'history'

            MDBoxLayout:
                orientation: 'vertical'
                padding: dp(12)
                spacing: dp(8)
                md_bg_color: app.theme_cls.surfaceContainerLowColor

                MDLabel:
                    text: app.strings['history_title']
                    font_style: 'Title'
                    role: 'large'
                    adaptive_height: True
                    theme_text_color: 'Custom'
                    text_color: app.theme_cls.primaryColor
                    bold: True

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(3)
                    radius: [dp(2)]
                    md_bg_color: app.theme_cls.primaryColor

                MDSegmentedButton:
                    size_hint_y: None
                    height: dp(48)

                    MDSegmentedButtonItem:
                        active: True
                        on_release: app.select_period('week')

                        MDSegmentButtonLabel:
                            text: app.strings['week']

                    MDSegmentedButtonItem:
                        on_release: app.select_period('month')

                        MDSegmentButtonLabel:
                            text: app.strings['month']

                    MDSegmentedButtonItem:
                        on_release: app.select_period('all')

                        MDSegmentButtonLabel:
                            text: app.strings['all_time']

                MoodChart:
                    id: mood_chart
                    size_hint: 1, 0.9

                MDScrollView:
                    size_hint_y: 0.1

                    MDGridLayout:
                        id: entries_list
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(8)

        MDScreen:
            name: 'settings'

            MDBoxLayout:
                orientation: 'vertical'
                padding: dp(20)
                spacing: dp(14)
                md_bg_color: app.theme_cls.surfaceContainerLowColor

                MDLabel:
                    text: app.strings['settings_title']
                    font_style: 'Title'
                    role: 'large'
                    adaptive_height: True
                    theme_text_color: 'Custom'
                    text_color: app.theme_cls.primaryColor
                    bold: True

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(3)
                    radius: [dp(2)]
                    md_bg_color: app.theme_cls.primaryColor

                MDLabel:
                    text: app.strings['language_title']
                    font_style: 'Label'
                    role: 'large'
                    adaptive_height: True

                MDSegmentedButton:
                    size_hint_y: None
                    height: dp(48)

                    MDSegmentedButtonItem:
                        id: russian_segment
                        on_release: app.set_language('ru')

                        MDSegmentButtonLabel:
                            text: app.strings['russian']

                    MDSegmentedButtonItem:
                        id: english_segment
                        on_release: app.set_language('en')

                        MDSegmentButtonLabel:
                            text: app.strings['english']

                MDLabel:
                    text: app.strings['theme_title']
                    font_style: 'Label'
                    role: 'large'
                    adaptive_height: True

                MDSegmentedButton:
                    size_hint_y: None
                    height: dp(48)

                    MDSegmentedButtonItem:
                        id: dark_segment
                        on_release: app.set_theme('dark')

                        MDSegmentButtonLabel:
                            text: app.strings['dark']

                    MDSegmentedButtonItem:
                        id: light_segment
                        on_release: app.set_theme('light')

                        MDSegmentButtonLabel:
                            text: app.strings['light']

                MDButton:
                    style: 'tonal'
                    radius: dp(16)
                    pos_hint: {'center_x': 0.5}
                    on_release: app.open_github()

                    MDButtonIcon:
                        icon: 'github'
                    MDButtonText:
                        text: app.strings['github']

    MDNavigationBar:
        id: navigation_bar
        on_switch_tabs: app.switch_screen(*args)

        NavigationItem:
            icon_name: 'emoticon-outline'
            text_key: 'today'
            screen_name: 'today'
            active: True

        NavigationItem:
            icon_name: 'chart-line'
            text_key: 'history'
            screen_name: 'history'

        NavigationItem:
            icon_name: 'cog-outline'
            text_key: 'settings'
            screen_name: 'settings'
